PORT=4300
FRONTEND_URL=http://localhost:3000
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
# URL para Node ejecutado en el host; codificar caracteres especiales de la clave.
DATABASE_URL=postgresql://hivibe:CHANGE_DATABASE_PASSWORD@localhost:5433/hivibe?schema=public
# URL dentro de Compose, con la misma contraseña codificada.
DOCKER_DATABASE_URL=postgresql://hivibe:CHANGE_DATABASE_PASSWORD@db:5432/hivibe?schema=public
JWT_SECRET=CHANGE_JWT_SECRET
# local usa un volumen persistente; cloudinary requiere las tres variables siguientes.
MEDIA_PROVIDER=local
MEDIA_LOCAL_PATH=./uploads
MEDIA_PUBLIC_URL=http://localhost:4300/media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
